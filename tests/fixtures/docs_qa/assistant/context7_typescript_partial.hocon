# A TypeScript question goes to Context7: routing follows where the docs live, not who makes the product (issue 02).
# Schema: https://github.com/cognizant-ai-lab/neuro-san/blob/main/docs/test_case_hocon_reference.md
{
    "agent": "docs_qa/assistant",
    "connections": "direct",
    # Calls the /docs_qa/verifier external agent in-process. Without it, the test driver looks for it over HTTP
    # on a running server, and the Coordinator runs with no Verifier.
    "use_direct": true,
    # The three samples run in parallel; two must pass.
    "success_ratio": "2/3",
    "timeout_in_seconds": 540,
    "interactions": [
        {
            "text": "In TypeScript, how do I make every property of an existing type optional?",
            "response": {
                "text": {
                    # The Coordinator labels each source link with the source it came from, so the labels show
                    # which Specialist answered.
                    "keywords": ["Partial", "[1]", "Sources", "(Context7)"],
                    "not_keywords": ["(Microsoft Learn)", "excerpt_ids", "\"quote\""]
                }
            }
        }
    ]
}
